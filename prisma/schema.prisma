generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ADMIN = a COACH (account manager) plus agency-level controls (Google
// connection, creating other admins). See lib/auth.ts.
enum UserRole {
  ADMIN
  COACH
  CLIENT
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ClientType {
  TRADE
  SERVICE
  OTHER
}

enum ClientStatus {
  ACTIVE
  ONBOARDING
  CHURNED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

// From Hive OS — richer payment typing (deposit/second/full/retainer),
// kept alongside the original coaching app's simpler `label` free-text field.
enum PaymentType {
  DEPOSIT
  SECOND_PAYMENT
  FULL_PAYMENT
  RETAINER
}

enum ContractStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskSource {
  MANUAL
  CLICKUP
}

model Task {
  id            String     @id @default(cuid())
  title         String
  status        TaskStatus @default(NOT_STARTED)
  assignee      String?
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  dueDate       DateTime?
  source        TaskSource @default(MANUAL)
  clickupTaskId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, dueDate])
  @@index([clientId])
}

// ── Onboarding template — global checklist, applied to every client ────
model OnboardingStepTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String   @default("task_alt")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  completions ClientOnboardingStep[]
}

model ClientOnboardingStep {
  id          String                 @id @default(cuid())
  clientId    String
  client      Client                 @relation(fields: [clientId], references: [id])
  templateId  String
  template    OnboardingStepTemplate @relation(fields: [templateId], references: [id])
  completedAt DateTime?

  @@unique([clientId, templateId])
}

// ── Playbooks / course modules ──────────────────────────────────────────
model Module {
  id      String   @id @default(cuid())
  title   String
  order   Int      @default(0)
  lessons Lesson[]
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id])
  title     String
  videoUrl  String?
  content   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  completions ClientLessonProgress[]
}

model ClientLessonProgress {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  completedAt DateTime?

  @@unique([clientId, lessonId])
}

// ── Ads (original coaching app) — lightweight per-post metrics, schema-ready for a
// Meta Ads API / server-tracker sync. Kept alongside Hive OS's daily-spend
// model below since they answer different questions (creative performance
// vs. day-by-day spend/ROAS).
model AdCampaign {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  name           String
  status         String    @default("active")
  spend          Decimal   @default(0) @db.Decimal(10, 2)
  impressions    Int       @default(0)
  profileVisits  Int       @default(0)
  engagement     Int       @default(0)
  saves          Int       @default(0)
  metaCampaignId String?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  // Coach override for whether this campaign's spend counts in reports
  // (lib/reporting-scope.ts). null = the default: included when the campaign
  // started on/after Client.startDate. A Meta campaign gets a row here (keyed
  // by metaCampaignId) only once a coach overrides it.
  includedInReporting Boolean?

  @@unique([clientId, metaCampaignId])
  @@index([clientId])
}

// ── Awards — auto-granted on revenue milestones or course completion ───
model AwardTier {
  id               String        @id @default(cuid())
  name             String
  subtitle         String?
  thresholdRevenue Decimal?      @db.Decimal(10, 2)
  requiredModuleId String?
  order            Int           @default(0)
  clientAwards     ClientAward[]
}

model ClientAward {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  awardTierId String
  awardTier   AwardTier @relation(fields: [awardTierId], references: [id])
  earnedAt    DateTime  @default(now())

  @@unique([clientId, awardTierId])
}

// ── Integration settings — single row, ClickUp / CRM connection info ───
model IntegrationSettings {
  id             String   @id @default("singleton")
  clickupApiKey  String?
  clickupTeamId  String?
  crmType        String? // "ghl" | "spreadsheet"
  crmApiKeyOrUrl String?
  // Slack bot token from "Add to Slack" (app/api/slack/*), encrypted at rest.
  slackBotToken  String?
  slackTeamName  String?
  updatedAt      DateTime @updatedAt
}

// ── Google (Hive OS) — the one Google account used to read every
// client's lead sheet. Singleton table — only ever one row, created/
// replaced on connect. Not per-client OAuth.
model GoogleAccountConnection {
  id           String   @id @default(cuid())
  accessToken  String // encrypted at rest (see lib/crypto.ts)
  refreshToken String // encrypted at rest
  expiresAt    DateTime
  googleEmail  String? // shown in the UI so you know which account is connected
  // Space-separated OAuth scopes Google granted. Writing status back to the
  // sheets needs ".../auth/spreadsheets" (not ".readonly"); null = connected
  // before write-back existed, so it's treated as read-only.
  scope        String?
  connectedAt  DateTime @default(now())
}

// ── Which spreadsheet/tab/columns are assigned to each client (Hive OS) ──
// Sticks until changed — no token here, just points at a sheet and is read
// using the single GoogleAccountConnection above.
model ClientSheet {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  spreadsheetId   String
  spreadsheetName String?
  sheetName       String

  allColumns     String[]
  visibleColumns String[]
  statusColumn   String?
  // Maps the sheet's own free-text status values (whatever the team has
  // been typing into statusColumn) to our fixed 6-status funnel — e.g.
  // {"New": "NEW_LEAD", "Called": "CHASE_UP"}. Unmapped values default to
  // NEW_LEAD on sync (see lib/lead-sync.ts).
  statusMapping  Json?

  // The "did it close" column (e.g. a client's "Prospect Status") — separate
  // from statusColumn (e.g. "HIVE STATUS", the team's internal outreach
  // stage). When resultStatusMapping resolves a row to something more
  // conclusive (Won/Lost/Disqualified) than statusMapping did, the result
  // wins — see moreConclusive() in lib/lead-status.ts. Revenue (Quote Value /
  // Revenue Generated) is only ever counted on a lead once THIS column
  // resolves it to Won — a bare "quoted, not yet closed" row never counts.
  resultStatusColumn  String?
  resultStatusMapping Json?

  // Outcome of the last sheet → Lead table sync (see lib/lead-sync.ts) —
  // shown on the client's Leads tab so a failed sync is visible, not silent.
  lastSyncedAt     DateTime?
  lastSyncError    String?
  // Normalized status values seen in the last sync that had no mapping —
  // {status: {value: count}, result: {value: count}} — shown as a warning
  // with a quick-map dropdown on the Leads tab.
  unmappedStatuses Json?

  // Two-way sync (lib/sheet-writeback.ts). Each status column's dropdown
  // values, read from its data validation on every sync — what HQ writes back
  // is always one of these. writeMapping = the coach's per-client overrides
  // of which value a stage writes: {status: {"WON": "SOLD"}, result: {...}}.
  statusOptions       String[] @default([])
  resultStatusOptions String[] @default([])
  writeMapping        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The real sales funnel, in order (see STAGE_RANK in lib/lead-status.ts).
// WON / LOST / DISQUALIFIED are terminal. CHASE_UP is the entry stage (the
// old NEW_LEAD was folded into it).
enum LeadStage {
  CHASE_UP
  CONTACTED
  NURTURE
  HANDOVER_ATTEMPTED
  HANDOVER_LIVE
  HANDOVER_TEXT
  CLIENT_CONTACTED
  CONSULT_BOOKED
  CONSULT_CANCELLED
  CONSULT_NO_SHOW
  CONSULT_ATTENDED
  QUOTE_SENT
  WON
  LOST
  DISQUALIFIED
}

enum DqReason {
  GHOSTED
  SPAM
  NOT_INTERESTED
  BUDGET
  LOCATION
  PRICE_SHOPPER
  NOT_SUITABLE
  UNKNOWN
}

// How far the lead got before being disqualified.
enum DqPhase {
  PRE_CONTACT
  POST_CONTACT
  POST_HANDOVER
}

enum LostReason {
  GHOSTED
  WENT_ELSEWHERE
  BUDGET
  UNKNOWN
}

// SYNC / MANUAL / NOTE events carry a real timestamp and feed the duration
// medians (lib/milestones.ts).
// IMPORT (lead first seen already at that stage) and INFERRED (a skipped
// stage filled in on a jump) only count toward "reached", never durations.
enum StageEventSource {
  SYNC
  MANUAL
  IMPORT
  INFERRED
  NOTE // dated from the team's notes cell — timed, like SYNC/MANUAL
}

// ── Leads (Hive OS) — synced from each client's assigned Google Sheet ───
// (see lib/lead-sync.ts). Status syncs both ways: a stage changed in HQ is
// written back to the sheet's status cell (lib/sheet-writeback.ts), and the
// latest change on either side wins. Every other column is read-only.
model Lead {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  name         String?
  phone        String?
  email        String?
  source       String?
  campaign     String?
  adset        String?
  stage        LeadStage   @default(CHASE_UP)
  dqReason     DqReason?
  dqPhase      DqPhase?
  lostReason   LostReason?
  // From a sheet column whose header contains "attempt", if there is one.
  callAttempts Int?
  value        Decimal?    @db.Decimal(10, 2)

  // The literal, unmapped status text straight from the sheet's status
  // column (e.g. "LIVE TRANSFER", "Self booked") — kept separately from
  // `stage` (our fixed funnel) so leads are filterable by
  // whatever the sheet actually says even before (or without) a client
  // configuring the statusMapping on ClientSheet.
  sheetStatus String?
  // Each status column's raw text on its own: HIVE STATUS (our team) and
  // Prospect Status (the client's word on the outcome).
  hiveStatusRaw     String?
  prospectStatusRaw String?
  // Handed to the client (handover / client contacted / nurture / booked)
  // but they haven't reported back yet: Prospect Status is blank or
  // "pending update" and the lead isn't closed. See lib/lead-sync.ts.
  awaitingClientUpdate Boolean @default(false)
  // When the lead was first handed over (any HANDOVER_STAGES): its milestone
  // (dated note, else a stage change seen live), else when a sync first saw
  // it at a handover. The "Update your leads" clock and reminders run from
  // this. Kept by refreshHandoverAt (lib/reminders.ts).
  handoverAt           DateTime?
  // Sat in its stage 2× the client's usual time (lib/reminders.ts) — "Likely
  // lost? Close it out" on the Update panel + CLIENT_UPDATE_OVERDUE.
  staleInStage         Boolean   @default(false)

  // Stable identity across repeated syncs (normalized email/phone/name) —
  // no DB-level unique constraint; matched via findFirst in lib/lead-sync.ts.
  externalKey         String?
  // Every other sheet column (residency status, visa, employment, car
  // price/timeframe, address, ad creative, docs status, feedback, landing
  // page, etc.), keyed by header name — display-only, nothing computes on it.
  raw                 Json?
  // Two-way status sync: whichever side changed the stage last wins (see
  // lib/lead-sync.ts). sheetStatusUpdatedAt = the earliest the sheet's change
  // could have happened (the sync before we saw it); hqStatusUpdatedAt = when
  // someone changed it in HQ (which also queues a write-back).
  sheetStatusUpdatedAt DateTime?
  hqStatusUpdatedAt    DateTime?
  // Why the last write-back to the sheet failed — shown as "Not synced to
  // sheet". Cleared when a write succeeds.
  sheetWriteError      String?
  // What the sheet's status columns resolved to on the last sync — differs
  // from `stage` while an HQ change is newer (powers the "sheet says X"
  // badge), and a change in it is how a sync spots a new sheet edit.
  sheetStage          LeadStage?
  // sha256 of the feedback/notes cell last parsed into LeadNoteEvents — the
  // cell (and its AI classification) is only re-parsed when this changes.
  notesHash           String?
  lastSyncedAt        DateTime?

  // Soft delete — set when the lead's sheet row disappears (or the sheet is
  // unassigned). Every read filters deletedAt: null; a row that reappears
  // restores the same lead, notes and history intact.
  deletedAt DateTime?

  createdAt   DateTime         @default(now())
  activity    LeadActivity[]
  writeBacks  WriteBackJob[]
  reminders   LeadReminder[]
  notes       LeadNote[]
  stageEvents LeadStageEvent[]
  noteEvents  LeadNoteEvent[]

  @@index([clientId, createdAt])
  @@index([clientId, externalKey])
  @@index([clientId, deletedAt])
}

enum WriteBackStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// One cell to write back to a client's sheet: the lead's row (found by
// email → phone → name at write time, never by row number) × `column` (a
// header — only the status columns and Quote Value / Revenue are ever
// allowed). Processed by lib/sheet-writeback.ts, max 50 cells a minute.
model WriteBackJob {
  id        String          @id @default(cuid())
  clientId  String
  leadId    String
  lead      Lead            @relation(fields: [leadId], references: [id])
  column    String
  value     String
  status    WriteBackStatus @default(PENDING)
  attempts  Int             @default(0)
  error     String?
  runAfter  DateTime        @default(now())
  claimId   String?
  createdAt DateTime        @default(now())
  doneAt    DateTime?

  @@index([status, runAfter])
  @@index([leadId, column])
}

// "This lead needs your update" — raised for a lead the client has owed an
// update on for 7+ days (lib/reminders.ts): shown as a task on their
// Dashboard and emailed when email is configured. At most one per lead per
// 7 days; this table is that record.
model LeadReminder {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  reason    String // the reminder step: "awaiting" | "CONSULT_BOOKED" | "CONSULT_ATTENDED" | "QUOTE_SENT"
  createdAt DateTime  @default(now())
  emailedAt DateTime?

  @@index([leadId, createdAt])
  @@index([clientId, createdAt])
}

// Learned buying cycle per client (lib/buying-cycle.ts): the median days for
// each step from this client's own leads, cached — recomputed on the 1st of
// each month by the cron, or a coach's "Recalculate".
model ClientCycle {
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  step       String // handoverToAttended | attendedToQuote | quoteToClose
  medianDays Float?
  n          Int
  computedAt DateTime @default(now())

  @@id([clientId, step])
}

// ── Data health (lib/data-health.ts) ─────────────────────────────────────
// Problems with a client's data, re-checked after every sync. An alert stays
// one row per (client, type, fingerprint): re-seen → lastSeenAt; no longer
// found → RESOLVED; a coach's "Mark handled" → DISMISSED (with a note).
enum DataAlertType {
  STATUS_COLUMN_MISSING
  REQUIRED_COLUMN_MISSING
  UNMAPPED_STATUS
  LEAD_NO_CAMPAIGN
  WON_NO_VALUE
  QUOTE_NO_VALUE
  DQ_NO_REASON
  LOST_NO_REASON
  BAD_OPTIN_DATE
  CAMPAIGN_NAME_UNMATCHED
  NO_START_DATE
  NO_INCLUDED_CAMPAIGNS
  SYNC_FAILED
  SYNC_STALE
  SYNC_ABORTED_GUARD
  GOOGLE_TOKEN_INVALID
  META_TOKEN_EXPIRED
  WRITEBACK_FAILED
  CLIENT_UPDATE_OVERDUE
  RECONCILE_MISMATCH
  SLACK_FAILED
  CLICKUP_FAILED
}

enum AlertSeverity {
  DANGER
  WARNING
}

enum AlertStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model DataAlert {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  type            DataAlertType
  severity        AlertSeverity
  title           String
  detail          String
  fixHint         String
  fixUrl          String?
  count           Int           @default(0)
  affectedLeadIds String[]      @default([])
  fingerprint     String        @default("")
  status          AlertStatus   @default(OPEN)
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  resolvedAt      DateTime?
  dismissNote     String?
  clickupTaskId   String?

  @@unique([clientId, type, fingerprint])
  @@index([status, severity])
}

// Raw sheet vs HQ after each sync (lib/reconcile.ts). ok = no diffs.
model SyncReconciliation {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  sheetCounts Json
  hqCounts    Json
  diffs       Json
  ok          Boolean
  createdAt   DateTime @default(now())

  @@index([clientId, createdAt])
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

// Every Slack post (lib/slack.ts): events and digests are queued here and
// sent by the cron, so a Slack outage never breaks a sync. dedupeKey makes
// each post happen once — "sale:<leadId>", "digest:<clientId>:2026-10-02".
model SlackPostLog {
  id        String         @id @default(cuid())
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id])
  channel   String
  kind      String // sale | live_transfer | weekly_update | client_digest | admin_digest | test
  dedupeKey String         @unique
  text      String
  status    DeliveryStatus @default(PENDING)
  attempts  Int            @default(0)
  error     String?
  createdAt DateTime       @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// ClickUp tasks HQ created (lib/clickup.ts), deduped by key — "alert:<id>",
// "review:<clientId>:<week>", "weekly:<clientId>:<week>" — so each is made
// once, and closed when what raised it is resolved.
model ClickUpTaskLog {
  id        String         @id @default(cuid())
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id])
  kind      String // alert | chase_client | account_review | weekly_update | manual
  dedupeKey String         @unique
  title     String
  taskId    String?
  taskUrl   String?
  status    DeliveryStatus @default(PENDING)
  closedAt  DateTime?
  error     String?
  createdAt DateTime       @default(now())

  @@index([clientId, createdAt])
}

// Free-text follow-up notes on an individual lead — separate from
// ProgressNote (which is per-client, for the coaching relationship overall).
// A coach or the lead's own client can add one; shown in the lead detail
// popup alongside its status history.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  note      String
  createdBy String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// Full status-change history: manual edits (lib/actions.ts) AND a sheet
// re-sync moving an existing, non-manually-owned lead to a new stage
// (lib/lead-sync.ts). The one thing NOT logged here is a brand-new lead's
// very first status on creation — that's routine ingestion, not a "change".
// Powers the "Activity" list in a lead's expanded detail row.
model LeadActivity {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  fromStatus LeadStage
  toStatus   LeadStage
  value      Decimal?  @db.Decimal(10, 2)
  changedBy  String
  changedAt  DateTime  @default(now())

  @@index([leadId, changedAt])
}

// Every stage a lead has reached, with when and how we know — the source of
// truth for funnel "reached" counts, time-between-stages medians and the
// time-series chart. LeadActivity above is the human-readable audit log.
model LeadStageEvent {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id])
  stage     LeadStage
  at        DateTime
  source    StageEventSource
  createdAt DateTime         @default(now())

  @@index([leadId, stage])
}

enum NoteEventType {
  CALL_ATTEMPT
  DQ_SPAM
  HANDOVER_LIVE
  HANDOVER_TEXT
  CONSULT_BOOKED
  CONSULT_ATTENDED
  QUOTE_SENT
  NOTE
}

enum NoteEventSource {
  REGEX
  AI
}

// One dated entry from the sheet's feedback/notes cell ("HS 12/3> NP"),
// parsed by lib/notes-parser.ts (REGEX) or Claude for what the rules miss
// (AI). The team's own dates — the source of truth for stage timing in the
// funnel's duration medians. Rebuilt whenever the cell changes (notesHash).
model LeadNoteEvent {
  id        String          @id @default(cuid())
  leadId    String
  lead      Lead            @relation(fields: [leadId], references: [id])
  at        DateTime
  who       String
  event     NoteEventType
  rawText   String
  source    NoteEventSource
  createdAt DateTime        @default(now())

  @@index([leadId, event])
}

// ── Contracts / renewals (Hive OS) — drives "renewal" needs-action cards ─
model Contract {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id])
  startDate    DateTime
  endDate      DateTime
  status       ContractStatus @default(ACTIVE)
  monthlyValue Decimal        @db.Decimal(10, 2)
  autoRenew    Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([status, endDate])
}

// ── Contact / call log (Hive OS) — drives "no call in N+ days" cards ────
model ContactLog {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  contactedAt DateTime
  method      String // "call" | "meeting" | "message" (older rows: "email")
  notes       String?
  loggedBy    String // who from Hive made contact
  nextStep    String?
  nextStepDue DateTime?
  createdAt   DateTime @default(now())

  @@index([clientId, contactedAt])
}

// ── Ad spend, synced daily from Meta Marketing API (Hive OS) ────────────
model AdSpendDaily {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  date        DateTime
  spend       Decimal  @db.Decimal(10, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  source      String   @default("meta")

  @@unique([clientId, date, source])
  @@index([clientId, date])
}

// ── Revenue, synced from Stripe or manual entry (Hive OS) ────────────────
model RevenueMonthly {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id])
  month    DateTime
  amount   Decimal  @db.Decimal(10, 2)
  source   String   @default("manual")

  @@unique([clientId, month])
}

// BACKFILL = rebuilt from history (opt-in dates + notes) by a coach's
// "Rebuild history" or the backfill script — rebuilt again on request.
// FROZEN = stored by the cron once the month ended; never overwritten.
enum KpiSource {
  BACKFILL
  FROZEN
}

// ── Snapshot KPIs, frozen per Sydney calendar month (see lib/kpi.ts) ─────
// A row exists once a month has ended and been frozen (month-end freeze in
// the cron sync, or the backfill script) — later sheet edits never rewrite a
// closed month. The current month is always computed live, never stored.
model MonthlyKpi {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  month          String // "2026-09" — Sydney calendar month
  leads          Int
  contacted      Int       @default(0) // leads first contacted in the month
  liveTransfers  Int
  consultsBooked Int
  quotes         Int
  sales          Int       @default(0) // leads won in the month (won date)
  revenue        Decimal   @default(0) @db.Decimal(12, 2) // their job values
  spend          Decimal?  @db.Decimal(10, 2) // null = no dated spend source for that month
  spendSource    String? // "meta" | "daily"
  source         KpiSource @default(FROZEN)
  frozenAt       DateTime  @default(now())

  @@unique([clientId, month])
}

// Auth lives in Clerk — this table is a read-model mirror of the account
// (kept in sync by the Clerk webhook, see app/api/webhooks/clerk/route.ts).
// The source of truth for role/clientId at request time is Clerk's
// publicMetadata (see lib/auth.ts) — this table exists so pages can join
// against a local User row (e.g. Settings → Team list) without an extra
// Clerk API round trip.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // maps to Clerk's user.id
  email     String   @unique
  role      UserRole
  name      String
  clientId  String? // required for role=CLIENT, null for role=COACH (coach/admin sees everything)
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  @@index([clientId])
}

enum ReferralStage {
  INTRODUCED
  REACHED_OUT
  IN_CONVERSATION
  CALL_BOOKED
  CALL_DONE
  WON
}

model ReferralLink {
  id        String     @id @default(cuid())
  code      String     @unique
  label     String
  // Set for a client's own unique referral link (auto-created — see
  // getOrCreateClientReferralLink in lib/actions.ts); null for the
  // agency-generic links the coach creates for their own bio/DMs.
  clientId  String?    @unique
  client    Client?    @relation(fields: [clientId], references: [id])
  createdAt DateTime   @default(now())
  referrals Referral[]
}

model Referral {
  id             String        @id @default(cuid())
  name           String
  source         String?
  note           String?
  stage          ReferralStage @default(INTRODUCED)
  referralLinkId String?
  referralLink   ReferralLink? @relation(fields: [referralLinkId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([stage])
}

model Program {
  id            String   @id @default(cuid())
  name          String
  description   String?
  durationWeeks Int?
  clients       Client[]
  createdAt     DateTime @default(now())
}

model Client {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  email       String?
  isActive    Boolean      @default(true)
  status      ClientStatus @default(ONBOARDING)
  // Independent of status — an archived client is hidden from every default
  // list/dashboard view regardless of ACTIVE/ONBOARDING/CHURNED, but keeps
  // all their data. null = not archived.
  archivedAt  DateTime?
  goals       String?
  description String?
  scope       String? // free-text scope of engagement, e.g. "Paid ads management" — replaces the fixed Program picker on the create-client form
  programId   String?
  program     Program?     @relation(fields: [programId], references: [id])
  joinedAt    DateTime     @default(now())
  // Onboarding date (Sydney midnight) — reports only count leads, sales and
  // spend on/after it, and "Since start" means startDate → today. null =
  // everything counts (see lib/reporting-scope.ts).
  startDate   DateTime?

  // ── Original coaching app — coaching-business relations ──────────────────────────
  users             User[]
  sessions          Session[]
  progressNotes     ProgressNote[]
  payments          Payment[]
  tasks             Task[]
  onboardingSteps   ClientOnboardingStep[]
  lessonProgress    ClientLessonProgress[]
  adCampaigns       AdCampaign[]
  awards            ClientAward[]
  gameplanFigmaLink String?

  // ── Hive OS — agency connections / reporting relations ───────────────
  logoUrl          String?
  metaAdAccountId  String? // "act_XXXXXXXXX" — not secret, safe to store plain
  metaAccessToken  String? // encrypted at rest (see lib/crypto.ts)
  clickupListId    String? // ClickUp list for this client's tasks (lib/clickup.ts)
  // Slack channel for this client's posts (lib/slack.ts), and which posts are
  // on: {sales, liveTransfers, weeklyUpdates, dailyDigest} — missing = on.
  slackChannelId   String?
  slackEvents      Json?
  claritySlug      String? // Microsoft Clarity project slug
  stripeCustomerId String?

  // What a CLIENT login may see in their own reports — {showProfit,
  // showCostMetrics, showDqBreakdown, showFunnel}; null/missing keys = the
  // defaults in lib/report-visibility.ts. Enforced server-side: hidden data is
  // never sent to a CLIENT. Coaches always see everything.
  reportVisibility Json?
  // TRADE clients' reports say "Onsite quote" / "Job won" instead of
  // "Quote" / "Sale" (lib/client-terms.ts).
  clientType       ClientType @default(OTHER)
  // Coach overrides of the buying cycle, in days, e.g. { "quoteToClose": 45 }
  // (lib/buying-cycle.ts). Missing keys = learned, else the default.
  cycleOverrides   Json?

  contracts      Contract[]
  monthlyKpis    MonthlyKpi[]
  contactLogs    ContactLog[]
  adSpendDaily   AdSpendDaily[]
  revenueMonthly RevenueMonthly[]
  leads          Lead[]
  leadReminders  LeadReminder[]
  cycles         ClientCycle[]
  dataAlerts     DataAlert[]
  weeklyUpdates  WeeklyUpdate[]
  slackPosts     SlackPostLog[]
  clickupTasks   ClickUpTaskLog[]
  reconciliations SyncReconciliation[]
  clientSheet    ClientSheet?
  referralLink   ReferralLink?
}

// A coach's weekly status update for a client — shown on the client's
// Dashboard as "This week's update" (newest first, with history).
model WeeklyUpdate {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  weekOf    DateTime // Monday of the week, Sydney midnight
  wins      String
  issues    String
  nextSteps String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, weekOf])
  @@index([clientId, weekOf])
}

model Session {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  scheduledAt DateTime
  durationMin Int           @default(45)
  status      SessionStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([clientId, scheduledAt])
}

model ProgressNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  note      String
  createdBy String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

// Merged: the original coaching app's simple free-text `label` + Hive OS's typed `type`,
// `amountPaid` and `stripeInvoiceId` for real payment-sync support.
model Payment {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  type            PaymentType? // optional — rows from the original coaching app won't have one
  label           String
  amountDue       Decimal       @db.Decimal(10, 2)
  amountPaid      Decimal?      @db.Decimal(10, 2)
  dueDate         DateTime
  status          PaymentStatus @default(PENDING)
  paidDate        DateTime?
  stripeInvoiceId String?
  createdAt       DateTime      @default(now())

  @@index([status, dueDate])
}
