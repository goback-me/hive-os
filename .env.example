POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://coach:change-this-password@postgres:5432/coach_os
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Clerk — from your Clerk dashboard → your app → API Keys.
# NEXT_PUBLIC_* is safe to expose to the browser (required for client-side auth UI).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — NEVER expose this to the browser, NEVER prefix with NEXT_PUBLIC_.
# Used server-side (lib/clerk-admin.ts, middleware.ts) for session checks and to
# create/delete client & coach logins.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Routing — matches app/login/[[...login]]/page.tsx in this project.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# Clerk Dashboard → Webhooks → create endpoint at /api/webhooks/clerk,
# subscribe to user.created/user.updated/user.deleted, paste its signing
# secret here. Keeps the Prisma User table in sync as a fallback/mirror —
# createUser (lib/actions.ts) already sets publicMetadata directly, so the
# app works even before this webhook is wired up.
CLERK_WEBHOOK_SECRET=
# IMPORTANT: in Clerk Dashboard → User & Authentication → Restrictions,
# turn OFF "Allow sign-ups" — accounts are only ever created by a coach
# (Settings → Team → Create user).

# ── Hive OS connections, merged in for the Ads/Leads panels ──────────────
# Meta Marketing API — per-client act_/token pair is stored on Client
# (metaAdAccountId/metaAccessToken, encrypted at rest); these are only
# needed for the OAuth connect flow itself.
META_APP_ID=
META_APP_SECRET=

# Leads tab — Google Sheets connect (Google Cloud Console → Credentials).
# One admin-level account for the whole agency (GoogleAccountConnection),
# not per-client OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://portal.hivesocial.agency/api/google/callback
# Generate with: openssl rand -hex 32 — encrypts stored Google/Meta tokens at rest
TOKEN_ENCRYPTION_KEY=

# Cron lead sync — GET /api/cron/sync must send header `x-cron-secret: <this>`.
# Generate with: openssl rand -hex 32. Called by n8n every 5 min (DEPLOYMENT.md).
CRON_SECRET=
