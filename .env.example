# Hive HQ — every environment variable the app reads. See DEPLOYMENT.md.
# Required unless marked optional.

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://coach:change-this-password@postgres:5432/coach_os

# The app's public URL — used for redirects and the links in Slack/email/ClickUp.
NEXTAUTH_URL=https://hq.hivesocial.agency

# ── Clerk (logins) — Clerk dashboard → your app → API Keys ───────────────
# NEXT_PUBLIC_* is safe to expose to the browser (required for client-side auth UI).
# Publishable key (starts with "pk_").
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key (starts with "sk_") — NEVER expose this to the browser / never
# prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
# Clerk Dashboard → Webhooks → endpoint at /api/webhooks/clerk, events
# user.created / user.updated / user.deleted → paste its signing secret.
# Keeps the local User table mirrored (login works without it).
CLERK_WEBHOOK_SECRET=
# Turn OFF "Allow sign-ups" in Clerk → User & Authentication → Restrictions.

# Bootstrap admin for `npm run create-admin` (creates / promotes this login
# to ADMIN). ADMIN_PASSWORD is only used when the Clerk account is new.
# In dev, ADMIN_EMAIL also enables /api/dev-login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Google (lead sheets, read + write) — Google Cloud Console → Credentials
# One agency account for every client's sheet. Scopes: spreadsheets
# (read/write — status write-back), drive.readonly, userinfo.email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hq.hivesocial.agency/api/google/callback

# Encrypts stored Google / Meta tokens at rest. `openssl rand -hex 32`.
# Meta needs no app keys here: each client's ad account ID + access token is
# pasted on their Ads tab and stored encrypted with this.
TOKEN_ENCRYPTION_KEY=

# ── Cron — GET /api/cron/sync must send `x-cron-secret: <this>` ─────────
# Run every 5 minutes by the VPS crontab (DEPLOYMENT.md). `openssl rand -hex 32`.
CRON_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────
# Classifies feedback-note entries the regex rules can't place
# (claude-sonnet-4-6). Unset = those entries stay plain notes.
ANTHROPIC_API_KEY=

# Emails clients their 7-day "leads waiting on your update" reminders via
# Resend. Unset = reminders only show in the app. (SMTP isn't supported.)
RESEND_API_KEY=
EMAIL_FROM=Hive Social <updates@hivesocial.agency>

# Slack bot (chat:write) — invite it to each client channel and the admin
# channel. Unset = no Slack posts.
SLACK_BOT_TOKEN=
SLACK_ADMIN_CHANNEL=

# ClickUp isn't configured here: add the API key + Team ID in the app under
# Settings → Integrations, then pick each client's list on its page.

# Dev only: lets `npm run db:demo` run with NODE_ENV=production (don't).
# ALLOW_DEMO_SEED=1
