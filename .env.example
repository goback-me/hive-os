# Postgres — local dev via docker-compose.yml (port 5434 to avoid the 5432
# conflict), or point at your VPS Postgres instance for a shared DB
DATABASE_URL="postgresql://hive:hive@localhost:5434/hive_portal"

# Meta Marketing API — same creds as Ad Performance OS
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Stripe — for automatic payment/invoice sync (optional for v1, can start manual)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ClickUp — for embedding client task lists
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# Microsoft Clarity — already have this MCP running per client memory notes
CLARITY_TOKEN_REVVY=
CLARITY_TOKEN_JOAT=
CLARITY_TOKEN_LOOP99=
CLARITY_TOKEN_PINKLOAN=

# NextAuth (client + admin login)
NEXTAUTH_SECRET=
NEXTAUTH_URL="https://portal.hivesocial.agency"
