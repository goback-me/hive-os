# Copy this to .env.prod on the VPS and fill in real values.
# The app container reads this file (see docker-compose.prod.yml's
# `env_file: .env.prod`).

# Host is "postgres" — the service name in docker-compose.prod.yml,
# NOT localhost, NOT the public domain. Password must match whatever
# you set in .env.compose.
DATABASE_URL="postgresql://hive:set-a-real-password-here@postgres:5432/hive_os"

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

NEXTAUTH_SECRET=
NEXTAUTH_URL="https://portal.hivesocial.agency"
