# Copy this file to .env and fill in real values before running deploy.sh
# This ONE file is used both by docker-compose (for the Postgres password)
# and by the app itself (DATABASE_URL, integration keys).

# Pick a real password. This sets up Postgres AND must match the password
# inside DATABASE_URL below — they are the same value, used twice.
POSTGRES_PASSWORD=change-this-password

# Host is "postgres" — that's the service name below, not localhost,
# not your domain. Password must exactly match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://change:change-this-password@postgres:5432/change_os

# Optional — leave blank if you don't have these yet, the app still runs
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# Leads tab — Google Sheets connect (from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-website-url/api/google/callback
TOKEN_ENCRYPTION_KEY=

NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-website-url
